{
  "name": "teklifbul-web",
  "version": "1.0.1",
  "type": "module",
  "description": "Teklifbul - tedarik / teklif yonetim sistemi (web istemci, API ve Firebase Functions)",
  "main": "migrate.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server.cjs",
    "dev:api": "node server/start-api.js",
    "api": "node server/start-api.js",
    "start": "npm run dev",
    "migrate": "node migrate.js",
    "migrate:apply": "node migrate.js --apply",
    "subscriptions:migrate:defaults": "node scripts/migrate-set-default-plan.js",
    "subscriptions:seed:test-data": "node scripts/create-premium-test-data.js",
    "migrate:demands": "tsx src/db/migrations/run-migrations.ts src/modules/demands/migrations/001_create_demands_tables.sql",
    "export:role-permissions": "tsx server/scripts/export-role-permissions-template.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:rules": "firebase emulators:exec --only firestore \"npx vitest run --config vitest.rules.config.ts\"",
    "test:functions": "vitest run tests/functions.test.ts",
    "test:stocks": "npm run test:rules && npm run test:functions",
    "seed:categoryRules": "node scripts/import-category-rules.js",
    "cleanup:evidenceTokens": "node scripts/cleanup-evidence-tokens.js",
    "backfill:security": "node scripts/backfill-security-projections.js",
    "backfill:security:apply": "node scripts/backfill-security-projections.js --apply",
    "lint": "eslint .",
    "lint:ci": "eslint \"server/**/*.ts\" --quiet",
    "type-check": "tsc --noEmit",
    "build:api": "tsc -p server/tsconfig.build.json && node scripts/fix-functions-dist-imports.mjs && node scripts/copy-role-permissions-template.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "seo:smoke": "node scripts/seo-smoke.mjs",
    "scan:assets": "node scripts/asset-scan.mjs",
    "preflight": "node scripts/preflight.mjs",
    "preflight:quick": "node scripts/preflight.mjs --skip-smoke",
    "predeploy": "npm run build:api && npm run build",
    "deploy": "npm run predeploy && firebase deploy",
    "prepare": "husky || true",
    "cap:sync": "npm run build && npx cap sync",
    "cap:android": "npm run cap:sync && npx cap open android",
    "cap:ios": "npm run cap:sync && npx cap open ios",
    "cap:assets": "npx capacitor-assets generate --android --ios --assetPath resources --iconBackgroundColor \"#2563EB\" --iconBackgroundColorDark \"#1E40AF\" --splashBackgroundColor \"#2563EB\" --splashBackgroundColorDark \"#1E40AF\"",
    "cap:build:android": "npm run cap:sync && cd android && .\\gradlew.bat assembleRelease",
    "cap:bundle:android": "npm run cap:sync && cd android && .\\gradlew.bat bundleRelease",
    "cap:check": "powershell -ExecutionPolicy Bypass -File ./scripts/check-mobile-prereqs.ps1",
    "cap:keystore": "powershell -ExecutionPolicy Bypass -File ./scripts/generate-android-keystore.ps1",
    "cap:keystore:auto": "powershell -ExecutionPolicy Bypass -File ./scripts/generate-android-keystore.ps1 -NonInteractive",
    "cap:push:setup": "powershell -ExecutionPolicy Bypass -File ./scripts/setup-google-services.ps1"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "eslint --fix --max-warnings=9999"
    ],
    "*.{json,md,html,css}": []
  },
  "keywords": [
    "firebase",
    "firestore",
    "migration"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/ios": "^8.4.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/network": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@google-cloud/recaptcha-enterprise": "^4.1.0",
    "@google/genai": "^1.30.0",
    "@sentry/browser": "^10.27.0",
    "@sentry/node": "^10.27.0",
    "@types/compression": "^1.8.1",
    "@types/pdfkit": "^0.17.4",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.19",
    "docx": "^8.5.0",
    "dompurify": "^3.2.2",
    "dotenv": "^17.2.3",
    "dotenv-safe": "^9.1.0",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "fast-levenshtein": "^3.0.0",
    "fast-xml-parser": "^5.7.2",
    "firebase": "^12.13.0",
    "firebase-admin": "^12.0.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.2",
    "jszip": "^3.10.1",
    "mammoth": "^1.11.0",
    "multer": "^1.4.5-lts.1",
    "node-cache": "^5.1.2",
    "openai": "^4.104.0",
    "p-limit": "^7.2.0",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.17.2",
    "pg": "^8.16.3",
    "resend": "^6.7.0",
    "winston": "^3.18.3",
    "xlsx": "npm:@keep-lts/xlsx@0.18.6",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@eslint/js": "^9.0.0",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/cors": "^2.8.19",
    "@types/dompurify": "^3.0.5",
    "@types/express": "^5.0.5",
    "@types/express-rate-limit": "^5.1.3",
    "@types/multer": "^2.1.0",
    "@types/node": "^24.10.1",
    "@types/uuid": "^10.0.0",
    "@vitest/ui": "^4.0.14",
    "eslint": "^9.0.0",
    "eslint-plugin-html": "^8.1.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "globals": "^15.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "sharp": "^0.34.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.2.6",
    "vitest": "^4.0.14"
  },
  "overrides": {
    "@types/node": "^24.10.1",
    "xlsx": "npm:@keep-lts/xlsx@0.18.6"
  }
}
