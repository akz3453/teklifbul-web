{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "module": "ES2020",
        "moduleResolution": "Node",
        "outDir": "../functions/dist",
        "noEmit": false,
        "rootDir": "..",
        "sourceMap": false,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "target": "ES2020"
    },
    "include": [
        ".",
        "../types/**/*.d.ts",
        "../src/vite-env.d.ts",
        "../src/shared/log/**/*.ts",
        "../src/shared/utils/migration-enhanced.ts",
        "../src/modules/categories/**/*.ts",
        "../src/modules/taxOffices/routes/**/*.ts",
        "../src/modules/taxOffices/types/**/*.ts",
        "../src/modules/taxOffices/utils/**/*.ts",
        "../src/modules/taxOffices/services/**/*.ts",
        "../src/modules/inventory/services/**/*.ts",
        "../src/modules/inventory/types/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "**/*.test.ts",
        "**/*.spec.ts",
        "../src/shared/log/error-tracker.ts",
        "../src/shared/hooks/**",
        "../src/shared/queue/**",
        "../src/shared/ui/**",
        "../src/import/**",
        "../src/lib/**",
        "../src/components/**",
        "../src/features/**",
        "../src/pages/**",
        "../src/context/**",
        "../src/routing/**",
        "../src/security/**"
    ]
}