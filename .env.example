# ============================================
# Teklifbul Web - Environment Variables Template
# ============================================
#
# Kullanım:
#   1. Bu dosyayı .env olarak kopyala:  cp .env.example .env
#   2. Değerleri kendi ortamına göre doldur
#   3. Hassas bilgileri (şifreler, API key'ler) ASLA commit etme
#
# Teklifbul Rule v1.0 - Environment variables template
# ============================================

# ============================================
# API Configuration
# ============================================
NODE_ENV=development
# NODE_ENV=production            # Production için
API_PORT=5174
API_URL=http://localhost:5174

# ============================================
# CORS / Origin Whitelist
# ============================================
# Virgülle ayrılmış domain listesi. Üretimde MUTLAKA gerçek domain ekle.
# Hem ALLOWED_ORIGINS hem CORS_ALLOWED_ORIGINS destekleniyor (legacy uyum).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,https://teklifbul.web.app,https://teklifbul.firebaseapp.com
# CORS_ALLOWED_ORIGINS=...      # Eski isim, gerekirse

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_MAX=100               # /api genel limit (15dk pencere)
AUTH_RATE_LIMIT_MAX=5            # /api/auth (15dk pencere)
UPLOAD_RATE_LIMIT_MAX=10         # /api/upload (1 saat pencere)
EXPORT_RATE_LIMIT_MAX=20         # /api/export (15dk pencere)
PUBLIC_TOKEN_RATE_LIMIT_MAX=30   # /api/bid-invites, /api/submit-bid (15dk)
WEBHOOK_RATE_LIMIT_MAX=60        # /api/payments/webhook (1dk)

# ============================================
# Firebase (Client-side, Vite prefix)
# ============================================
# Firebase Console -> Project Settings -> Web App
# Client-side değerler public sayılır ancak yine de gerçek değerleri commit etme.
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxxxxxxxx

# FCM (Firebase Cloud Messaging) - Cloud Messaging -> Web Push certificates
VITE_FCM_VAPID_KEY=your-vapid-public-key

# Browser Sentry (opsiyonel — boşsa no-op)
VITE_SENTRY_DSN=

# Google Analytics 4 (public measurement ID, örn. G-XXXXXXXX. Boşsa analytics no-op)
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# reCAPTCHA Enterprise (AppCheck için ZORUNLU - production)
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=your-recaptcha-enterprise-site-key
# Production'da App Check varsayılan zorunlu. Yalnızca acil skip: VITE_APP_CHECK_ENFORCE=0
# VITE_APP_CHECK_ENFORCE=0

# Markalı doğrulama e-postası (Resend). Production'da API 502 + Firebase kotası yakıyordu.
# Varsayılan kapalı; yalnız Firebase Auth sendEmailVerification kullanılır.
# VITE_BRANDED_EMAIL_VERIFICATION=1

# ============================================
# Firebase Admin SDK (Server-side)
# ============================================
# UYARI: Aşağıdaki private key ASLA repoya commit edilmemelidir.
# Yöntemler (sırayla kontrol edilir):
#   1. FIREBASE_SERVICE_ACCOUNT (JSON string)        -> CI/CD için önerilen
#   2. GOOGLE_APPLICATION_CREDENTIALS (dosya yolu)
#   3. serviceAccountKey.json (proje kökünde)
#
# Tek satıra sıkıştırılmış service account JSON; gerçek değeri Secret Manager'da tut.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project-id","private_key_id":"REPLACE_ME","private_key":"-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_YOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com","client_id":"000000000000000000000","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-xxxxx%40your-project-id.iam.gserviceaccount.com","universe_domain":"googleapis.com"}

# Alternatif: Dosya yolu
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# ============================================
# AI / LLM
# ============================================
# Groq (https://console.groq.com/keys) - üretimde Secret Manager'da tut
GROQ_API_KEY=gsk_REPLACE_WITH_YOUR_KEY

# Opsiyonel: OpenAI / Google Generative AI / Gemini
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# GEMINI_MODEL_ID=gemini-1.5-flash
# GEMINI_VISION_MODEL_ID=gemini-1.5-flash

# Varsayilan AI provider ('groq' | 'openai' | 'gemini')
AI_DEFAULT_PROVIDER=groq

# Min token bakiyesi (cuzdan kontrolu)
AI_MIN_TOKENS=100

# Sirket /api/chat stuck hold recovery TTL (ms). Min 60000. In-flight istekleri serbest birakmaz.
# AI_HOLD_TTL_MS=300000

# AI rate limiting (15dk pencere)
AI_RL_FREE_MAX=10
AI_RL_PREMIUM_MAX=100
AI_RL_PREMIUM_PLUS_MAX=500
AI_RL_WINDOW_SEC=900
AI_AVAILABLE_MODELS_CACHE_SEC=300

# ============================================
# Sentry (Error Tracking)
# ============================================
# Production'da otomatik aktif (NODE_ENV=production ve SENTRY_DSN varsa)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1   # 0.0 - 1.0 (0.1 = %10 sample)

# ============================================
# Logging / Observability
# ============================================
LOG_LEVEL=info                   # debug | info | warn | error
# LOG_FILE_PATH=./logs/app.log   # Dosyaya yazmak istenirse
ENABLE_METRICS=0                 # 0 | 1 (Prometheus metrics endpoint)
OBS_LOG_ALL=0                    # 1 olursa tum istekleri loglar
OBS_SLOW_MS=1000                 # Yavas request esigi (ms)
OBS_EVENTS_MAX=1000              # Bellek icindeki son event sayisi

# ============================================
# Email (Transactional)
# ============================================
# Resend (https://resend.com) - one onerilen
RESEND_API_KEY=
# Brevo / Mailjet alternatifleri:
# BREVO_API_KEY=
# MAILJET_API_KEY=
# MAILJET_API_SECRET=
SENDER_EMAIL=noreply@teklifbul.com

# ============================================
# Admin / Yetkilendirme
# ============================================
# Virgulle ayrilmis admin email listesi (super admin yetkisi)
ADMIN_EMAILS=

# ============================================
# Application URLs
# ============================================
APP_URL=http://localhost:5173    # Frontend canonical URL (email link'leri vb.)
APP_VERSION=1.0.0
TB_ENV=development               # development | staging | production

# ============================================
# Frontend (VITE_*) - build sirasinda inject edilir
# ============================================
# Google Maps JS API anahtari. Production'da Google Cloud Console'da
# HTTP referrer kisitlamasi MUTLAKA aktif olmali (sadece teklifbul.com vb.)
VITE_GOOGLE_MAPS_API_KEY=
# Frontend AppCheck reCAPTCHA Enterprise site key
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Firebase config (mevcut public anahtarlar - .env'de override edilebilir)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# ============================================
# Payment / Webhook Secrets
# ============================================
# Firebase Functions webhook'lari icin paylasilan secret
PAYMENT_WEBHOOK_SECRET=replace-with-strong-random-string
# Escrow banka webhook'u (kullaniliyorsa)
ESCROW_BANK_WEBHOOK_SECRET=
# Üretimde gerçek ödeme sağlayıcı URL zorunlu (sandbox default yok)
PAYMENT_CHECKOUT_BASE_URL=https://pay.teklifbul-sandbox.local/checkout
# ALLOW_MOCK_AI_PURCHASES=true   # yalnız development + admin; production'da yok sayılır
ENABLE_ESCROW_DEMO=0

# ============================================
# reCAPTCHA / Bot Protection
# ============================================
# Production'da MUTLAKA "0" olmali (=disabled degil)
RECAPTCHA_DISABLED=0

# ============================================
# Edoc / E-belge Rate Limits (15dk pencere)
# ============================================
RATE_LIMIT_EDOC_SEND_MAX=20
RATE_LIMIT_EDOC_PDF_MAX=60
RATE_LIMIT_EDOC_STATUS_MAX=120
RATE_LIMIT_EDOC_CANCEL_MAX=10
RATE_LIMIT_EDOC_SETTINGS_GET_MAX=60
RATE_LIMIT_EDOC_SETTINGS_UPDATE_MAX=20
RATE_LIMIT_EDOC_CREDENTIALS_UPDATE_MAX=10
RATE_LIMIT_SALE_DOCUMENT_CREATION_MAX=30
RATE_LIMIT_CLIENT_ERROR_INGEST_MAX=120

# ============================================
# Database (PostgreSQL) - opsiyonel, aktif kullanılmıyorsa boş bırak
# ============================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=teklifbul
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_MAX_CONNECTIONS=50
POSTGRES_MIN_CONNECTIONS=5

# ============================================
# Redis / Cache - opsiyonel
# ============================================
# REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_DISABLED=0
# CACHE_DISABLED=1               # Cache'i devre dışı bırak
CACHE_MONITORING_INTERVAL=60000
# Production: 300000 (5dk), Development: 60000 (1dk)

# ============================================
# Health Monitoring
# ============================================
HEALTH_CHECK_URL=http://localhost:5174/health
HEALTH_CHECK_INTERVAL=60000      # ms
MAX_HEALTH_FAILURES=3
ALERT_WEBHOOK_URL=               # opsiyonel webhook

# ============================================
# Migration Runner
# ============================================
MIGRATION_CONCURRENCY=10
MIGRATION_DRY_RUN=false
# MIGRATION_DRY_RUN=true         # Firestore yazma işlemlerini simüle et
MIGRATION_RUN_ID=

# ============================================
# Pool Monitoring (opsiyonel)
# ============================================
ENABLE_POOL_MONITORING=0
# ENABLE_POOL_MONITORING=1       # Production'da otomatik aktif

# ============================================
# Legacy / Migration Flags (default: kapali)
# ============================================
# Eski entitlement provider-wide modu (yeni sirketlerde kullanma)
TB_LEGACY_ENTITLEMENT_PROVIDER_WIDE=0
# Eski universal wallet modu (yeni sirketlerde kullanma)
TB_LEGACY_WALLET_UNIVERSAL=0

# ============================================
# Debug Flags (production'da hepsi 0/false)
# ============================================
DEBUG_CACHE=0
DEBUG_PERMISSIONS=0
HEALTH_CHECK_FIRESTORE=1

# ============================================
# Notlar
# ============================================
# 1. Hassas Bilgiler (ASLA commit etme):
#    POSTGRES_PASSWORD, REDIS_PASSWORD, FIREBASE_SERVICE_ACCOUNT,
#    GROQ_API_KEY, OPENAI_API_KEY, GEMINI_API_KEY, SENTRY_DSN,
#    PAYMENT_WEBHOOK_SECRET, ESCROW_BANK_WEBHOOK_SECRET,
#    RESEND_API_KEY, BREVO_API_KEY, MAILJET_API_*
#
# 2. Firebase Admin SDK:
#    - serviceAccountKey.json mutlaka .gitignore'da (zaten var)
#    - Production: FIREBASE_SERVICE_ACCOUNT (Secret Manager) kullan
#
# 3. Production Ayarlari (deploy oncesi kontrol):
#    NODE_ENV=production
#    TB_ENV=production
#    ALLOWED_ORIGINS=<canli-domain>
#    APP_URL=<canli-frontend-url>
#    SENTRY_DSN=<production-dsn>
#    SENTRY_TRACES_SAMPLE_RATE=0.1 (uretimde)
#    VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=<reCAPTCHA-Enterprise-key>
#    RECAPTCHA_DISABLED=0
#    PAYMENT_WEBHOOK_SECRET=<kuvvetli-rastgele-deger>
#    ADMIN_EMAILS=<super-admin-listesi>
#    DEBUG_CACHE=0
#    DEBUG_PERMISSIONS=0
#    LOG_LEVEL=info (veya warn)
#
# ============================================
