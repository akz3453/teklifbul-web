{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "module": "CommonJS",
        "moduleResolution": "Node",
        "outDir": "../functions/dist",
        "noEmit": false,
        "rootDir": "..",
        "sourceMap": false,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "target": "ES2020"
    },
    "include": [
        ".",
        "../src/shared/**/*.ts",
        "../src/modules/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "**/*.test.ts",
        "**/*.spec.ts"
    ]
}